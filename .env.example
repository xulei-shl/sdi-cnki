# Backend (loaded by app/config.py)
APP_NAME="CNKI 学术定题服务系统"
DEBUG=false
DATABASE_URL="sqlite+aiosqlite:///./data/cnki_service.db"
JWT_SECRET_KEY="change-me-to-a-random-secret-key-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AES_ENCRYPTION_KEY="change-me-to-32-char-key!!!!!"
API_KEY=

CNKI_USERNAME=
CNKI_PASSWORD=

LLM_CONFIG=
LLM_BATCH_SIZE=5
LLM_MAX_ROUNDS=3

PAGE_TIMEOUT=60
NAVIGATION_TIMEOUT=60
CAPTCHA_TIMEOUT=240
ACTION_TIMEOUT=60
PAGE_CHANGE_TIMEOUT=160

# Frontend (Vite exposes VITE_* to client)
VITE_HIAGENT_APP_KEY=
VITE_HIAGENT_PROMPT_APP_KEY=
VITE_HIAGENT_BASE_URL=https://hiagent.library.sh.cn
